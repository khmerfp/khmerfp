# Optional overrides for docker compose.
# Copy to ".env" in the repo root (git-ignored) and edit as needed.
# Without this file, every value below falls back to the default in
# docker-compose.yml.

# --- Local PostgreSQL container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=khmerfp
# Host port for Postgres. Change if 5432 is already in use on your machine.
POSTGRES_PORT=5432

# --- API ---
# Host port for the Express API.
SERVER_PORT=3000
# Comma-separated browser origins allowed by CORS. The web container is 8080.
APP_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Web (nginx serving the built client) ---
WEB_PORT=8080
