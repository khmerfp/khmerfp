PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/angkor_payment

GOOGLE_CLIENT_ID=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APP_ORIGINS=http://localhost:5173
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_DAYS=7
# Shared secret of the Telegram bot used for the Login Widg
# Vonage (Nexmo) is the only SMS provider. It delivers phone OTP codes for
# phone login and registration; without credentials no SMS is sent.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=
PHONE_OTP_TTL_MINUTES=5
PHONE_OTP_MAX_ATTEMPTS=5
# Fixed-window rate limit applied to /api/auth/* endpoints.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_BLOCK_MINUTES=15

# PayWay remains disabled unless this is exactly true.
PAYWAY_ENV=sandbox
PAYWAY_CHECKOUT_ENABLED=false
PAYWAY_SANDBOX_MERCHANT_ID=
PAYWAY_SANDBOX_API_KEY=
# Separate callback HMAC secret supplied or confirmed by PayWay.
PAYWAY_SANDBOX_CALLBACK_SECRET=
PAYWAY_SANDBOX_SUCCESS_URL=http://localhost:5173/payment/result
PAYWAY_SANDBOX_CANCEL_URL=http://localhost:5173/payment/cancel

# Production placeholders remain unused while production checkout is blocked.
PAYWAY_PRODUCTION_MERCHANT_ID=
PAYWAY_PRODUCTION_API_KEY=
# Keep the callback credential separate unless PayWay confirms otherwise.
PAYWAY_PRODUCTION_CALLBACK_SECRET=
PAYWAY_PRODUCTION_SUCCESS_URL=https://pay.example.com/payment/result
PAYWAY_PRODUCTION_CANCEL_URL=https://pay.example.com/payment/cancel
