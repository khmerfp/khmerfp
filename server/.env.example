# Copy to .env and fill in the values for your environment.
# Every variable below is read by the server. See .env.test.example for the
# separate database used by the integration tests.

# HTTP server
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres@localhost:5432/payway

# Allowed browser origins for CORS and post-login redirects (comma separated).
# Add the exact client origin here when the client and API are deployed separately.
APP_ORIGINS=http://localhost:5173

# Session lifetime
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_DAYS=7

# Google sign-in. Only the web client id is needed: the browser sends the ID
# token and the server verifies its signature against Google's public keys.
GOOGLE_CLIENT_ID=

# Facebook Login. The app id is public; the secret stays server-side and is
# only used to exchange an authorization code for an access token.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Telegram Login Widget (sign-in and 2FA).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Phone OTP. Vonage is the only SMS provider; without credentials no SMS is
# sent and the code is only available through the server log.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=
PHONE_OTP_TTL_MINUTES=5
PHONE_OTP_MAX_ATTEMPTS=5

# Fixed-window rate limit applied to /api/auth/* endpoints.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_BLOCK_MINUTES=15

# PayWay remains disabled unless this is exactly true.
PAYWAY_ENV=sandbox
PAYWAY_CHECKOUT_ENABLED=false
PAYWAY_SANDBOX_MERCHANT_ID=
PAYWAY_SANDBOX_API_KEY=
# Separate callback HMAC secret supplied or confirmed by PayWay.
PAYWAY_SANDBOX_CALLBACK_SECRET=
PAYWAY_SANDBOX_SUCCESS_URL=http://localhost:5173/payment/result
PAYWAY_SANDBOX_CANCEL_URL=http://localhost:5173/payment/cancel

# Production placeholders remain unused while production checkout is blocked.
PAYWAY_PRODUCTION_MERCHANT_ID=
PAYWAY_PRODUCTION_API_KEY=
# Keep the callback credential separate unless PayWay confirms otherwise.
PAYWAY_PRODUCTION_CALLBACK_SECRET=
PAYWAY_PRODUCTION_SUCCESS_URL=https://pay.example.com/payment/result
PAYWAY_PRODUCTION_CANCEL_URL=https://pay.example.com/payment/cancel
