{
  "name": "angkor-payment",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "Frontend",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names frontend,server --prefix-colors cyan,green \"npm run dev --workspace Frontend\" \"npm run dev --workspace server\"",
    "dev:frontend": "npm run dev --workspace Frontend",
    "dev:server": "npm run dev --workspace server",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace Frontend",
    "render-build": "npm ci --include=dev && npm run build",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:server": "npm run test --workspace server"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "pg": "^8.23.1"
  }
}
