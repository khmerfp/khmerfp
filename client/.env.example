# Copy to .env and adjust for your environment.

# Google OAuth Web client ID used by Google Identity Services.
# This is a public value (same as server GOOGLE_CLIENT_ID).
# If left blank, the app falls back to the ID returned by GET /api/auth/config.
VITE_GOOGLE_CLIENT_ID=

# Facebook app id used by the Facebook JavaScript SDK login button.
# This is a public value (same as server FACEBOOK_APP_ID).
# If left blank, the app falls back to the ID returned by GET /api/auth/config.
VITE_FACEBOOK_APP_ID=

# Base URL for API requests. Set this to the separately deployed API origin for
# production builds. Leave blank in local development to use the Vite proxy.
VITE_API_URL=

# Optional local API target used by the Vite development proxy.
VITE_DEV_API_PROXY=http://localhost:3000
